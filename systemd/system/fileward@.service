[Unit]
Description=Fileward automation for %i
ConditionPathExists=/etc/fileward/%i.conf
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
User=%i
RuntimeDirectory=fileward-%i
RuntimeDirectoryMode=0700
ExecStartPre=/usr/local/bin/fileward validate --config /etc/fileward/%i.conf
ExecStart=/usr/local/bin/fileward run --systemd --config /etc/fileward/%i.conf --journal /var/log/fileward/%i/events.jsonl --control-socket /run/fileward-%i/control.sock
ExecStartPost=/usr/local/bin/fileward health --socket /run/fileward-%i/control.sock
ExecReload=/usr/local/bin/fileward reload --socket /run/fileward-%i/control.sock
Restart=on-failure
RestartSec=2s
WatchdogSec=20s
TimeoutStartSec=30s
TimeoutStopSec=10s
KillMode=control-group
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
