[Unit]
Description=Fileward local automation daemon

[Service]
Type=simple
ExecStart=%h/.local/bin/fileward run --config %h/.config/fileward/fileward.conf --state-file %h/.local/share/fileward.state --journal %h/.local/state/fileward/events.jsonl
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
