[Unit]
Description=Fileward local automation daemon
After=default.target
ConditionPathIsDirectory=%h/Downloads

[Service]
Type=simple
ExecStart=%h/.local/bin/fileward start --daemon --pidfile %h/.cache/fileward.pid --log-file %h/.local/share/fileward.log --state-file %h/.local/share/fileward.state %h/Downloads
ExecReload=%h/.local/bin/fileward reload --pidfile %h/.cache/fileward.pid
Restart=on-failure
RestartSec=2s

[Install]
WantedBy=default.target
