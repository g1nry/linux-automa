<group name="fileward,">
  <!-- Полные записи с timestamp/event_type могут сначала совпасть с Suricata 86600.
       Каждый дочерний маршрут обязан повторять проверку источника и схемы. -->
  <rule id="100800" level="0">
    <decoded_as>json</decoded_as>
    <field name="provider">^fileward$</field>
    <field name="schema_version">^1$</field>
    <description>Fileward structured event</description>
  </rule>
  <rule id="100801" level="5">
    <if_sid>100800,86600</if_sid>
    <field name="provider">^fileward$</field>
    <field name="schema_version">^1$</field>
    <field name="kind">^action_result$</field>
    <field name="outcome">^failure$</field>
    <description>Fileward action $(action) failed: $(code), path $(relative_path)</description>
  </rule>
  <rule id="100802" level="7">
    <if_sid>100800,86600</if_sid>
    <field name="provider">^fileward$</field>
    <field name="schema_version">^1$</field>
    <field name="kind">^event_dropped$</field>
    <description>Fileward observation/queue loss: $(code)</description>
  </rule>
  <rule id="100803" level="5">
    <if_sid>100800,86600</if_sid>
    <field name="provider">^fileward$</field>
    <field name="schema_version">^1$</field>
    <field name="kind">^event_cancelled$</field>
    <field name="outcome">^failure$</field>
    <description>Fileward readiness failure: $(code)</description>
  </rule>
  <rule id="100804" level="5">
    <if_sid>100800,86600</if_sid>
    <field name="provider">^fileward$</field>
    <field name="schema_version">^1$</field>
    <field name="kind" type="pcre2">^(config_reload|watcher_error|runtime_error|state_error|config_load)$</field>
    <field name="outcome">^failure$</field>
    <description>Fileward runtime/configuration failure: $(code)</description>
  </rule>
  <!-- Лабораторный alert об успехе: при необходимости раскомментируйте правило
       ниже В ЭТОМ ЖЕ файле. Оно может создавать много alerts при массовом импорте. -->
  <!--
  <rule id="100805" level="3">
    <if_sid>100800,86600</if_sid>
    <field name="provider">^fileward$</field>
    <field name="schema_version">^1$</field>
    <field name="kind">^action_result$</field>
    <field name="outcome">^success$</field>
    <description>Fileward action $(action) succeeded, path $(relative_path)</description>
  </rule>
  -->
</group>
